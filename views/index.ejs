<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body
    class="h-screen flex flex-col bg-neutral-200 font-outfit overflow-y-auto"
  >
    <%- include("partials/header") %>

    <div class="flex pt-12 h-full">
      <%- include("partials/sidebar") %>

      <main class="xl:ml-64 flex-1 flex flex-col">
        <div class="grow">
          <!-- Hero -->
          <section class="px-4 py-16 bg-neutral-200">
            <div class="text-center">
              <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
                Welcome to
                <span class="text-teal-700 text-5xl">ChapterHub</span>
                Inventory
              </h1>
              <p class="text-md md:text-lg text-gray-600 max-w-2xl mx-auto">
                A simple, elegant inventory system for bookstores. Manage
                genres, track books, and keep your library organized.
              </p>

              <div class="mt-8 flex justify-center items-center gap-4">
                <a href="/genres" class="btn-lg"> Browse Genres </a>
                <a href="/books" class="btn-lg bg-neutral-950">
                  Explore Books
                </a>
              </div>
            </div>
          </section>

          <!-- Quick Nav Cards -->
          <section class="px-4 py-12 grid md:grid-cols-2 gap-8 bg-neutral-50">
            <!-- Genres Card -->
            <a
              href="/genres"
              class="block relative p-8 overflow-hidden rounded-2xl shadow hover:shadow-lg group transition border border-neutral-900"
            >
              <!-- Background Image -->
              <div
                class="absolute inset-0 bg-[url('/img/hero_second.jpg')] bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
              ></div>

              <!-- Gradient Overlay -->
              <div
                class="absolute z-20 inset-0 bg-linear-to-r from-teal-700/80 to-teal-700/5"
              ></div>

              <!-- Content -->
              <div class="relative z-30">
                <h2 class="text-2xl font-bold text-white mb-3">
                  📂 Manage Genres
                </h2>
                <p class="text-neutral-300">
                  Create, edit, and organize book genres. Helps keep your
                  bookstore structured.
                </p>
              </div>
            </a>

            <!-- Books Card -->
            <a
              href="/books"
              class="block relative p-8 overflow-hidden rounded-2xl group shadow hover:shadow-lg transition border border-neutral-900"
            >
              <!-- Background Image -->
              <div
                class="absolute inset-0 bg-[url('/img/hero_first.jpg')] bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
              ></div>

              <!-- Gradient Overlay -->
              <div
                class="absolute z-20 inset-0 bg-linear-to-r from-teal-700/70 to-teal-700/5"
              ></div>

              <!-- Content -->
              <div class="relative z-30">
                <h2 class="text-2xl font-bold text-white mb-3">
                  📘 Manage Books
                </h2>
                <p class="text-neutral-300">
                  Add new books, update quantities, assign genres, and track
                  your inventory effortlessly.
                </p>
              </div>
            </a>
          </section>
          <section class="px-4 py-12 bg-neutral-100 border-t border-neutral-300">
            <div class="max-w-7xl mx-auto">
              <!-- Header del Dashboard -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-2">
                <div>
                  <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-900">
                    Informe desde Data Studio
                  </h2>
                </div>
              </div>
              <!-- Iframe adaptable -->
              <div class="w-full bg-white rounded-2xl shadow-md border border-neutral-300 overflow-hidden">
                <iframe 
                  class="w-full border-0"
                  style="width: 100%; height: 850px;"
                  src="https://datastudio.google.com/embed/reporting/2c72e958-b792-4c4b-9bb0-91fa2e8dc4aa/page/8nUDG" 
                  allowfullscreen>
                </iframe>
              </div>
            </div>
          </section>
        </div>

        <%- include("partials/footer") %>
      </main>
    </div>
    <script src="/js/sidebar.js"></script>
  </body>
</html>
